# Add two number
# Medium 
# Python 
class Solution:
    def addTwoNumbers(self, l1: ListNode | None, l2: ListNode | None) -> ListNode | None:
        temp=ListNode(0)
        carry=0
        recent=temp
        while l1!=None or l2!=None or carry!=0 :
            sum=carry
            if l1!=None:
                sum=l1.val+sum
                l1=l1.next
            if l2!=None:
                sum+=l2.val
                l2=l2.next
            carry=sum//10
            newnode=ListNode(sum%10)
            recent.next=newnode
            recent=newnode
        return temp.next          